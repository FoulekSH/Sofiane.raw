generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id        String     @id @default(cuid())
  name      String
  email     String?    @unique
  phone     String?
  company   String?
  address   String?
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  siret     String?
  invoices  Invoice[]
  transfers Transfer[]
}

model Invoice {
  id           String    @id @default(cuid())
  clientId     String
  type         String    @default("INVOICE")
  invoiceNum   String    @unique
  issueDate    DateTime  @default(now())
  dueDate      DateTime?
  address      String?
  vatRate      Float     @default(20.0)
  vatAmount    Float     @default(0.0)
  totalAmount  Float
  status       String    @default("DRAFT")
  items        String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  footerNotes  String?
  paymentTerms String?
  client       Client    @relation(fields: [clientId], references: [id])
}

model Transfer {
  id        String         @id @default(cuid())
  token     String         @unique
  expiresAt DateTime
  downloads Int            @default(0)
  password  String?
  clientId  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  client    Client?        @relation(fields: [clientId], references: [id])
  files     TransferFile[]
}

model TransferFile {
  id           String   @id @default(cuid())
  transferId   String
  filename     String
  originalName String
  size         Int
  createdAt    DateTime @default(now())
  transfer     Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
}

model CategoryConfig {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  coverImage  String?
  description String?
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())
}

model Photo {
  id             String   @id @default(cuid())
  filename       String
  title          String?
  description    String?
  category       String   @default("Portfolio")
  order          Int      @default(0)
  isPublic       Boolean  @default(true)
  showOnHomePage Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  isHero         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Collaboration {
  id          String   @id @default(cuid())
  name        String
  image       String?
  description String?
  link        String?
  order       Int      @default(0)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
